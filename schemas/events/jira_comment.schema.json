{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodes.culture.dev/schemas/events/jira_comment.schema.json",
  "title": "Jira comment answer fact",
  "type": "object",
  "required": ["id", "answer"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "originating_question_id": {"type": "string"},
    "replier": {"type": "string"},
    "origin": {
      "type": "object",
      "properties": {
        "kind": {"type": "string"},
        "replier": {"type": "string"}
      },
      "required": ["kind"]
    },
    "answer": {
      "type": "object",
      "required": ["comment_id", "body"],
      "properties": {
        "comment_id": {"type": "string"},
        "body": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
