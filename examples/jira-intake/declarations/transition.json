{
  "name": "jira-intake-transition",
  "trigger": {
    "kind": "jira.comment",
    "reentry_limit": 0,
    "hop_limit": 9
  },
  "condition": "true",
  "action": {
    "kind": "jira.transition",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "transition",
      "graph_kind": "agent",
      "uses": "actor://company/jira-comment@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "verb": "transition_issue",
        "issue": "{jira-intake-intake:id}",
        "target": "In Progress"
      },
      "timeout": "10m",
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "ledger": {
          "propose": [
            "claim"
          ]
        },
        "contract": {
          "outcomes": {
            "issue_transitioned": {
              "schema": {
                "type": "object",
                "required": [
                  "issue"
                ]
              }
            }
          }
        },
        "policy": {
          "retry": {
            "maxAttempts": 1
          }
        }
      }
    }
  },
  "start_node": {
    "name": "jira-intake-post-comment-done",
    "deadline": "2h"
  },
  "landing_node": {
    "name": "jira-intake-transition-done",
    "deadline": "2h"
  }
}
