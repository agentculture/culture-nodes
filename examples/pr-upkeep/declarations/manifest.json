  "entries": [
    {
      "declaration": "pr-upkeep-route",
      "graph_workflow": "workflow.yaml",
      "legacy_trigger": {
        "onEvent": "pr-upkeep.pr",
        "when": "event.payload.source == \"github_pr\" && size(event.payload.findings) > 0"
      },
      "note": "Triggers on the same pr-upkeep.pr fact the graph workflow does (registered as a trigger kind by t31b; the event name is unchanged). The engine's event variables are the payload itself, so the graph guard's event.payload.X reads as event.X."
    },
    {
      "declaration": "pr-upkeep-sweep",
      "graph_workflow": "sweep-cycle.workflow.yaml",
      "legacy_trigger": {
        "onEvent": "pr-upkeep.sweep.due"
      },
      "note": "A genuine timer entry. The live schedule row pr-upkeep-sweep-5m emits pr-upkeep.sweep.due and stays as it is; cutover adds a schedule row emitting `timer` with payload {\"schedule\": \"pr-upkeep-sweep-5m\"} (an operator hand-turn, not made here)."
    }
  ],
  "links": [
    {
      "from": "pr-upkeep-intake-orphan",
