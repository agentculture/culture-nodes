{
  "name": "pr-upkeep-stage-pr-open",
  "trigger": {
    "kind": "agent.result",
    "reentry_limit": 0,
    "hop_limit": 10
  },
  "condition": "event.outcome == \"completed\" && !lineage[\"pr-upkeep-route\"].work_item.startsWith(\"gh:\")",
  "action": {
    "kind": "jira.comment",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "stage-pr-open",
      "graph_kind": "agent",
      "uses": "actor://company/jira-comment@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "verb": "post_comment",
        "issue": "{pr-upkeep-route:work_item}",
        "comment": "culture-nodes:stage=pr-open\nThe developer session finished and its fix is on a pull request awaiting a platform maintainer's merge decision; the approval task is in the culture-nodes control plane under this ticket's key."
      },
      "timeout": "10m",
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "ledger": {
          "propose": [
            "claim"
          ]
        },
        "contract": {
          "outcomes": {
            "comment_posted": {
              "schema": {
                "type": "object",
                "required": [
                  "issue",
                  "comment_id"
                ]
              }
            }
          }
        },
        "policy": {
          "retry": {
            "maxAttempts": 2
          }
        }
      }
    }
  },
  "start_node": {
    "name": "pr-upkeep-fix-done",
    "deadline": "168h"
  },
  "landing_node": {
    "name": "pr-upkeep-stage-pr-open-done",
    "deadline": "168h"
  },
  "exposes": [
    "pr-upkeep-route:work_item"
  ]
}
