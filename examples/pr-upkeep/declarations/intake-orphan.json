{
  "name": "pr-upkeep-intake-orphan",
  "trigger": {
    "kind": "code.result",
    "reentry_limit": 0,
    "hop_limit": 10
  },
  "condition": "event.outcome == \"passed\" && lineage[\"pr-upkeep-route\"].work_item.startsWith(\"gh:\")",
  "action": {
    "kind": "jira.create",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "intake-orphan",
      "graph_kind": "agent",
      "uses": "actor://company/jira-comment@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "verb": "create_issue",
        "project": "SCRUM",
        "summary": "{pr-upkeep-route:work_item}",
        "description": "Auto-created by the pr-upkeep loop for a pull request that had no Jira ticket. The summary names the repository and the PR number as gh:<owner>/<repo>#<n>; open pull request <n> of <owner>/<repo> on GitHub. The loop wrote this key into the PR body so later findings on the PR arrive keyed to this ticket.",
        "labels": [
          "orphan",
          "auto-created",
          "source:github",
          "repo:agentculture/culture-nodes"
        ]
      },
      "timeout": "10m",
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "ledger": {
          "propose": [
            "claim"
          ]
        },
        "contract": {
          "outcomes": {
            "issue_created": {
              "schema": {
                "type": "object",
                "required": [
                  "issue",
                  "id"
                ],
                "properties": {
                  "issue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "policy": {
          "retry": {
            "maxAttempts": 1
          }
        }
      }
    }
  },
  "start_node": {
    "name": "pr-upkeep-route-done",
    "deadline": "168h"
  },
  "landing_node": {
    "name": "pr-upkeep-intake-orphan-done",
    "deadline": "168h"
  }
}
