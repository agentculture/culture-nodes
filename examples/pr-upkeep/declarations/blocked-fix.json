{
  "name": "pr-upkeep-blocked-fix",
  "trigger": {
    "kind": "agent.result",
    "reentry_limit": 1,
    "hop_limit": 20
  },
  "condition": "event.outcome == \"blocked\"",
  "action": {
    "kind": "human.ask",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "blocked-fix",
      "graph_kind": "approval",
      "approver_ref": "group/platform-maintainers",
      "input": {
        "question": "fix is blocked. Review the agent report and resolve the obstacle.\nRetry: run the same agent work again.\nAbandon: record that this step is stopped, with no PR or Jira change.\nAcknowledge: record this blocked attempt and end.",
        "blocked_step": "fix",
        "agent_report": "{result}",
        "repository": "{pr-upkeep-route:repository:}",
        "number": "{pr-upkeep-route:number:}",
        "work_item": "{pr-upkeep-route:work_item:}",
        "ticket": "{pr-upkeep-stamp-pr:id:}"
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "approverRef": "group/platform-maintainers",
        "deadline": "168h"
      },
      "timeout": "168h",
      "outcomes": [
        "retry",
        "abandon",
        "acknowledged"
      ]
    }
  },
  "start_node": {
    "name": "pr-upkeep-fix-done",
    "deadline": "168h"
  },
  "landing_node": {
    "name": "pr-upkeep-blocked-fix-done",
    "deadline": "168h"
  }
}
