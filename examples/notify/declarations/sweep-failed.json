{
  "name": "notify-sweep-failed",
  "trigger": {
    "kind": "code.result",
    "reentry_limit": 0,
    "hop_limit": 8
  },
  "condition": "event.outcome == \"failed\"",
  "action": {
    "kind": "discord.post",
    "with": {
      "uses": "actor://company/notify-discord@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "title": "PR upkeep sweep failed",
        "description": "[Open the failed sweep run](https://nodes.culture.dev/runs/{firing_id})",
        "require_delivery": false
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "contract": {
          "outcomes": {
            "sent": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            },
            "delivery_failed": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            }
          }
        }
      }
    }
  },
  "start_node": {
    "name": "pr-upkeep-sweep-done",
    "deadline": "none"
  },
  "landing_node": {
    "name": "notify-sweep-failed-done",
    "deadline": "5m"
  },
  "exposes": [
    "firing_id"
  ]
}
