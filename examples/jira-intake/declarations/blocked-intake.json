{
  "name": "jira-intake-blocked-intake",
  "trigger": {
    "kind": "agent.result",
    "reentry_limit": 0,
    "hop_limit": 9
  },
  "condition": "event.outcome == \"blocked\"",
  "action": {
    "kind": "human.ask",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "blocked-intake",
      "graph_kind": "approval",
      "approver_ref": "group/platform-maintainers",
      "input": {
        "question": "Jira intake agent could not draft the issue comment. Review its report and resolve the obstacle. A decision closes this attempt.",
        "blocked_step": "intake",
        "agent_report": "{result}",
        "issue": "{jira-intake-intake:id:}",
        "details_url": "{jira-intake-intake:details_url:}"
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "approverRef": "group/platform-maintainers",
        "deadline": "168h"
      },
      "timeout": "168h"
    }
  },
  "start_node": {
    "name": "jira-intake-intake-done",
    "deadline": "2h"
  },
  "landing_node": {
    "name": "jira-intake-blocked-intake-done",
    "deadline": "168h"
  }
}
