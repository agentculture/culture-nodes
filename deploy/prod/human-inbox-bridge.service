# systemd user unit for the human-inbox actor bridge (adapters/human-inbox,
# task t16) — a kind=human actor-protocol bridge that parks culture-nodes
# invocations as durable inbox tasks until a person (or the sibling
# human-inbox-tracker.service) submits a result.
#
# There is exactly one logical human actor, unlike codex's per-host actors:
# a second bridge for it anywhere would create a second inbox racing the
# same tasks against the same actor row, and a second idempotency store that
# cannot see the first one's replays.
#
# WHICH HOST that one bridge runs on is not declared here. This header used
# to name one machine in capital letters while the actor was registered at a
# different machine's address, and the engine dispatches to the registration,
# not to the comment (issue #72). deploy.sh derives the host from the actor's endpoint_ref and
# refuses to install this unit anywhere else — so this file stays a
# host-agnostic artifact, and a stale host name here is a claim nothing
# would have kept true.
#
# Host-resident Python, execing the console script `uv tool install` copied
# into its own venv. It used to run `uv run --directory` against the shared
# ~/git/culture-nodes-agent checkout — but that is the codex AGENT WORKSPACE,
# which the codex-bridge lane fast-forwards to main, so a branch deploy
# installed units whose code was not in the directory they ran from. The
# tracker crash-looped 6272 times on that before it was found.
#
# Installed by deploy.sh's human-inbox lane to
# ~/.config/systemd/user/human-inbox-bridge.service.
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now human-inbox-bridge
#   journalctl --user -u human-inbox-bridge -f

[Unit]
Description=Culture Nodes human-inbox actor bridge (kind=human, runner protocol)
After=network-online.target

[Service]
# Non-secret config (host/port/state dir/actor id) rides one EnvironmentFile,
# the bearer token rides a second, separately-installed one — mirroring
# nodes-runner.env vs runner.secret and codex-bridge.env's own split of
# config from credential.
EnvironmentFile=%h/.culture-nodes/human-inbox-bridge.env
EnvironmentFile=%h/.culture-nodes/human-inbox.env
ExecStart=%h/.local/bin/human-inbox-bridge serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
