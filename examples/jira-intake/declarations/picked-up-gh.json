{
  "name": "jira-intake-picked-up-gh",
  "trigger": {
    "kind": "jira.issue.transitioned",
    "reentry_limit": 0,
    "hop_limit": 9
  },
  "condition": "lineage[\"jira-intake-intake\"].id.startsWith(\"gh:\")",
  "action": {
    "kind": "code.run",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "picked-up",
      "graph_kind": "end",
      "uses": "runner://headspace/docker@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de",
      "operation": {
        "image": "python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de",
        "argv": [
          "python3",
          "-c",
          "import json, os\nprint(json.dumps(json.loads(os.environ[\"NODES_INPUT_JSON\"]), sort_keys=True))\n"
        ],
        "network": "none",
        "allowedOutputPaths": []
      },
      "input": {
        "issue": "{jira-intake-intake:id}"
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "output": {
          "from": "/nodes/transition/output"
        }
      }
    }
  },
  "start_node": {
    "name": "jira-intake-transition-done",
    "deadline": "2h"
  },
  "landing_node": {
    "name": "jira-intake-picked-up-done",
    "deadline": "2h"
  }
}
