{
  "name": "pr-upkeep-stage-pr-open",
  "trigger": {
    "kind": "timer",
    "with": {
      "legacy_reactions": [
        {
          "from": "fix",
          "outcome": "completed",
          "when": "!input.work_item.startsWith(\"gh:\")"
        }
      ]
    },
    "hop_limit": 10
  },
  "condition": "true",
  "action": {
    "kind": "jira.comment",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "stage-pr-open",
      "graph_kind": "agent",
      "legacy": {
        "kind": "agent",
        "ownerRef": "team/platform-ai",
        "uses": "actor://company/jira-comment@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "ledger": {
          "propose": [
            "claim"
          ]
        },
        "input": {
          "bindings": {
            "verb": {
              "literal": "post_comment"
            },
            "issue": "/run/input/work_item",
            "comment": {
              "literal": "culture-nodes:stage=pr-open\nThe developer session finished and its fix is on a pull request awaiting a platform maintainer's merge decision; the approval task is in the culture-nodes control plane under this ticket's key."
            }
          }
        },
        "contract": {
          "outcomes": {
            "comment_posted": {
              "schema": {
                "type": "object",
                "required": [
                  "issue",
                  "comment_id"
                ]
              }
            }
          }
        },
        "policy": {
          "timeout": "10m",
          "retry": {
            "maxAttempts": 2
          }
        }
      },
      "variables": {
        "issue": "{work_item}"
      }
    }
  },
  "start_node": {
    "name": "stage-pr-open-ready",
    "deadline": "none"
  },
  "landing_node": {
    "name": "stage-pr-open-done",
    "deadline": "168h"
  }
}
