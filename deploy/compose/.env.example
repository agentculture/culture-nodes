# Culture Nodes local compose profile — environment defaults.
#
# Copy this file to `.env` in this directory (docker compose auto-loads a
# `.env` beside docker-compose.yml) and edit as needed, or point
# `docker compose --env-file <path>` at a copy elsewhere. Nothing here is a
# real secret: these are dev-only defaults for a stack that only runs on
# your machine, on a network nothing else can reach unless you choose to
# publish these ports further. Do not reuse any of these values outside
# local development.

# --- PostgreSQL (the authoritative store) ----------------------------------
# Enable the bundled database. Set this empty when NODES_DATABASE_URL points
# at an external PostgreSQL instance; no image or source change is needed.
COMPOSE_PROFILES=bundled-postgres
POSTGRES_USER=nodes
POSTGRES_PASSWORD=nodes-dev-only
POSTGRES_DB=nodes
# The bundled URL is still an ordinary deployment input. External installs
# replace this one line and normally choose verify-full or require.
DATABASE_SSLMODE=disable
NODES_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=${DATABASE_SSLMODE}
# Host port postgres is published on (container port is always 5432).
POSTGRES_PORT=5432

# --- MinIO (S3-compatible artifact storage) ---------------------------------
MINIO_ROOT_USER=nodesroot
MINIO_ROOT_PASSWORD=nodesroot-dev-only
# Host ports for the S3 API and the web console.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket the worker's artifact-store env is staged to use once that wiring
# lands (internal/artifacts/s3 exists; cmd/nodes/worker.go does not yet
# construct it — see docker-compose.yml's worker service comment).
NODES_ARTIFACT_S3_BUCKET=nodes-artifacts

# --- API (`nodes serve`) ----------------------------------------------------
# Host port the API is published on (container listens on :8080).
NODES_API_PORT=8080

# --- Worker (`nodes worker`) ------------------------------------------------
# Placeholder. `nodes serve` creates the "default" namespace with a fresh
# random id on first boot and there is no discovery endpoint yet, so this
# will not match the real id — see docker-compose.yml's worker service
# comment and README.md's "The code-runner boundary" section for what that
# does and does not prove.
NODES_NAMESPACE_ID=default

# HMAC secret for attempt-scoped callback tokens: the worker signs, the API
# verifies, so both read this one value. Dev-only, like everything else here.
# Absent, an actor can still answer synchronously; the ASYNCHRONOUS path
# (202 + callbacks) needs it.
NODES_CALLBACK_TOKEN_SECRET=compose-dev-only-callback-secret

# Bearer for POST /v1alpha1/actors. Closed by default in the compose file
# (unset = every registration refused); this dev-only value opens it so a
# local actor can be registered over HTTP rather than by INSERT.
NODES_ACTOR_REGISTRATION_TOKEN_SECRET=compose-dev-only-registration-secret

# --- OpenTelemetry (optional `telemetry` profile) ---------------------------
# UNSET by default, and that is the gate: internal/telemetry.New returns
# NoOp() when this is empty — no exporter, no goroutine, no dial. Point it at
# the bundled collector with
#   COMPOSE_PROFILES=bundled-postgres,telemetry
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# or at any other OTLP/gRPC collector, which is the same one-line change.
# deploy/compose/otel-smoke.sh does exactly this, twice, with and without.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- colleague-bridge (optional `agents` profile) ---------------------------
# `docker compose --profile agents up` only. COLLEAGUE_ENGINE=mock is a
# deterministic offline actor useful for a smoke test; point it at a real
# engine (e.g. vllm-openai) plus COLLEAGUE_BASE_URL for real dispatch — see
# adapters/colleague/README.md's Configuration table for the full surface.
# COLLEAGUE_BRIDGE_REPO_ALLOWLIST is empty by default, which means the
# bridge refuses every invocation (the safe default) until you mount a repo
# and list its container path here.
COLLEAGUE_ENGINE=mock
COLLEAGUE_BRIDGE_REPO_ALLOWLIST=
COLLEAGUE_BRIDGE_PORT=8085
