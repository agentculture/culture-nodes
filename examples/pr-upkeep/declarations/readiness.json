{
  "name": "pr-upkeep-readiness",
  "trigger": {
    "kind": "timer",
    "with": {
      "legacy_reactions": [
        {
          "from": "fix",
          "outcome": "completed",
          "when": "input.work_item.startsWith(\"gh:\")"
        },
        {
          "from": "stage-pr-open",
          "outcome": "comment_posted",
          "when": null
        }
      ]
    },
    "hop_limit": 10
  },
  "condition": "true",
  "action": {
    "kind": "code.run",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "readiness",
      "graph_kind": "code",
      "legacy": {
        "kind": "code",
        "ownerRef": "team/platform-ai",
        "uses": "runner://headspace/pr-upkeep-readiness@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "operation": {
          "image": "python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de",
          "network": "full",
          "environmentRefs": [
            "PR_UPKEEP_READINESS_SOURCE_URL",
            "PR_UPKEEP_READINESS_SOURCE_SHA256",
            "PR_UPKEEP_READINESS_GITHUB_API",
            "PR_UPKEEP_READINESS_SONAR_API",
            "PR_UPKEEP_READINESS_SONAR_COMPONENT",
            "PR_UPKEEP_READINESS_DEVAGUE_ROOT",
            "PR_UPKEEP_READINESS_DEVAGUE_SLUG",
            "GITHUB_TOKEN",
            "SONAR_TOKEN"
          ],
          "argv": [
            "python3",
            "-c",
            "import hashlib, os, subprocess, sys, tempfile, urllib.request\nwant = os.environ[\"PR_UPKEEP_READINESS_SOURCE_SHA256\"]\nbody = urllib.request.urlopen(os.environ[\"PR_UPKEEP_READINESS_SOURCE_URL\"], timeout=60).read()\nif hashlib.sha256(body).hexdigest() != want:\n    sys.exit(\"readiness: fetched bytes do not match the granted digest; refusing to run unverified code\")\npath = os.path.join(tempfile.mkdtemp(), \"readiness.py\")\nopen(path, \"wb\").write(body)\nsys.exit(subprocess.run([sys.executable, path]).returncode)\n"
          ]
        },
        "input": {
          "bindings": {
            "pr": "/run/input"
          }
        },
        "contract": {
          "outcomes": {
            "passed": {
              "schema": {
                "type": "object"
              }
            },
            "failed": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "ledger": {
          "observe": [
            "evidence"
          ]
        },
        "policy": {
          "timeout": "10m",
          "retry": {
            "maxAttempts": 2
          }
        }
      }
    }
  },
  "start_node": {
    "name": "readiness-ready",
    "deadline": "none"
  },
  "landing_node": {
    "name": "readiness-done",
    "deadline": "168h"
  }
}
