    },
    {
      "from": "pr-upkeep-stamp-pr",
      "to": "pr-upkeep-intake-orphan",
      "kind": "must",
      "why": "sole predecessor: stamps the ticket intake-orphan just created (jira.issue.created is the reaction to its jira.create)"
    },
    {
