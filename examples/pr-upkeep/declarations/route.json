{
  "name": "pr-upkeep-route",
  "trigger": {
    "kind": "timer",
    "with": {
      "legacy_event": "pr-upkeep.pr",
      "legacy_condition": "event.payload.source == \"github_pr\" && size(event.payload.findings) > 0"
    },
    "hop_limit": 10
  },
  "condition": "event.payload.source == \"github_pr\" && size(event.payload.findings) > 0",
  "action": {
    "kind": "code.run",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "route",
      "graph_kind": "decision",
      "legacy": {
        "kind": "decision",
        "ownerRef": "team/platform-ai",
        "input": {
          "bindings": {
            "work_item": "/run/input/work_item"
          }
        },
        "select": [
          {
            "outcome": "orphan",
            "when": "output.work_item.startsWith(\"gh:\")"
          },
          {
            "outcome": "keyed",
            "when": "true"
          }
        ]
      },
      "variables": {
        "work_item": "{work_item}"
      }
    }
  },
  "start_node": {
    "name": "root",
    "deadline": "none"
  },
  "landing_node": {
    "name": "route-done",
    "deadline": "168h"
  }
}
