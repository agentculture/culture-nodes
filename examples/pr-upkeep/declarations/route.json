{
  "name": "pr-upkeep-route",
  "trigger": {
    "kind": "pr-upkeep.pr",
    "reentry_limit": 0,
    "hop_limit": 10
  },
  "condition": "event.source == \"github_pr\" && size(event.findings) > 0",
  "action": {
    "kind": "code.run",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "route",
      "graph_kind": "decision",
      "uses": "runner://headspace/docker@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de",
      "operation": {
        "image": "python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de",
        "argv": [
          "python3",
          "-c",
          "import json, os\nprint(json.dumps(json.loads(os.environ[\"NODES_INPUT_JSON\"]), sort_keys=True))\n"
        ],
        "network": "none",
        "allowedOutputPaths": []
      },
      "input": {
        "source": "{0:source}",
        "repository": "{0:repository}",
        "number": "{0:number}",
        "head_sha": "{0:head_sha:}",
        "work_item": "{0:work_item}",
        "findings": "{0:findings}"
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "select": [
          {
            "outcome": "orphan",
            "when": "output.work_item.startsWith(\"gh:\")"
          },
          {
            "outcome": "keyed",
            "when": "true"
          }
        ]
      }
    }
  },
  "start_node": {
    "name": "root",
    "deadline": "none"
  },
  "landing_node": {
    "name": "pr-upkeep-route-done",
    "deadline": "168h"
  }
}
