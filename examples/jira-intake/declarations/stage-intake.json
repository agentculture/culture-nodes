{
  "name": "jira-intake-stage-intake",
  "trigger": {
    "kind": "jira.issue.transitioned",
    "reentry_limit": 0,
    "hop_limit": 9
  },
  "condition": "!lineage[\"jira-intake-intake\"].id.startsWith(\"gh:\")",
  "action": {
    "kind": "jira.comment",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "stage-intake",
      "graph_kind": "agent",
      "uses": "actor://company/jira-comment@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "verb": "post_comment",
        "issue": "{jira-intake-intake:id}",
        "comment": "culture-nodes:stage=intake\nculture-nodes picked this ticket up: an intake comment is on the ticket above and the board has been moved to In Progress. The run and its ledger are in the culture-nodes control plane under this ticket's key."
      },
      "timeout": "10m",
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "ledger": {
          "propose": [
            "claim"
          ]
        },
        "contract": {
          "outcomes": {
            "comment_posted": {
              "schema": {
                "type": "object",
                "required": [
                  "issue",
                  "comment_id"
                ]
              }
            }
          }
        },
        "policy": {
          "retry": {
            "maxAttempts": 2
          }
        }
      }
    }
  },
  "start_node": {
    "name": "jira-intake-transition-done",
    "deadline": "2h"
  },
  "landing_node": {
    "name": "jira-intake-stage-intake-done",
    "deadline": "2h"
  }
}
