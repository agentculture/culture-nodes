{
  "codex_bin": "__HOME__/.local/bin/codex",
  "codex_env": {
    "CODEX_HOME": "__HOME__/.codex",
    "UV_CACHE_DIR": "/tmp/culture-codex/uv-cache",
    "UV_TOOL_DIR": "/tmp/culture-codex/uv-tools",
    "UV_PYTHON_INSTALL_DIR": "/tmp/culture-codex/uv-python"
  },
  "host": "0.0.0.0",
  "port": 8086,
  "always_async": true,
  "default_sandbox": "read-only",
  "state_dir": "__HOME__/.culture-nodes/codex-bridge-state",
  "repo_allowlist": [
    "__HOME__/git/culture-nodes-agent"
  ]
}
