{
  "name": "notify-pr-work-item",
  "trigger": {
    "kind": "pr-upkeep.pr",
    "reentry_limit": 0,
    "hop_limit": 8
  },
  "condition": "true",
  "action": {
    "kind": "discord.post",
    "with": {
      "uses": "actor://company/notify-discord@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "title": "New finding on PR #{number} ({repository})",
        "description": "The pr-upkeep sweep found work on **[{repository} PR #{number}](https://github.com/{repository}/pull/{number})** and is routing it: a Jira ticket if the PR has none, then analysis and a fix.",
        "require_delivery": false
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "contract": {
          "outcomes": {
            "sent": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            },
            "delivery_failed": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            }
          }
        }
      }
    }
  },
  "start_node": {
    "name": "root",
    "deadline": "none"
  },
  "landing_node": {
    "name": "notify-pr-work-item-done",
    "deadline": "5m"
  },
  "exposes": [
    "repository",
    "number"
  ]
}
