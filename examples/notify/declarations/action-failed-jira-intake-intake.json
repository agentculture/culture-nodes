{
  "name": "notify-action-failed-jira-intake-intake",
  "trigger": {
    "kind": "action.failed",
    "reentry_limit": 0,
    "hop_limit": 8
  },
  "condition": "true",
  "action": {
    "kind": "discord.post",
    "with": {
      "uses": "actor://company/notify-discord@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "title": "jira-intake: intake failed",
        "description": "[Open the failed run](https://nodes.culture.dev/runs/{firing_id}) · status: {status} · class: {class}",
        "require_delivery": false
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "contract": {
          "outcomes": {
            "sent": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            },
            "delivery_failed": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            }
          }
        }
      }
    }
  },
  "start_node": {
    "name": "jira-intake-intake-done",
    "deadline": "none"
  },
  "landing_node": {
    "name": "notify-action-failed-jira-intake-intake-done",
    "deadline": "5m"
  },
  "exposes": [
    "class",
    "firing_id",
    "status"
  ]
}
