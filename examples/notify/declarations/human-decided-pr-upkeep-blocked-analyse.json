{
  "name": "notify-human-decided-pr-upkeep-blocked-analyse",
  "trigger": {
    "kind": "human.decision",
    "reentry_limit": 0,
    "hop_limit": 8
  },
  "condition": "true",
  "action": {
    "kind": "discord.post",
    "with": {
      "uses": "actor://company/notify-discord@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "title": "PR #{pr-upkeep-route:number} analyse decision: {outcome}",
        "description": "[{pr-upkeep-route:repository} PR #{pr-upkeep-route:number}](https://github.com/{pr-upkeep-route:repository}/pull/{pr-upkeep-route:number})",
        "require_delivery": false
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "contract": {
          "outcomes": {
            "sent": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            },
            "delivery_failed": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            }
          }
        }
      }
    }
  },
  "start_node": {
    "name": "pr-upkeep-blocked-analyse-done",
    "deadline": "none"
  },
  "landing_node": {
    "name": "notify-human-decided-pr-upkeep-blocked-analyse-done",
    "deadline": "5m"
  },
  "exposes": [
    "outcome",
    "pr-upkeep-route:number",
    "pr-upkeep-route:repository"
  ]
}
