{
  "name": "jira-intake-post-comment",
  "trigger": {
    "kind": "agent.result",
    "reentry_limit": 0,
    "hop_limit": 9
  },
  "condition": "event.outcome == \"intake_drafted\"",
  "action": {
    "kind": "jira.comment",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "post-comment",
      "graph_kind": "agent",
      "uses": "actor://company/jira-comment@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "verb": "post_comment",
        "issue": "{jira-intake-intake:id}",
        "comment": "{jira-intake-intake:summary}"
      },
      "timeout": "10m",
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "ledger": {
          "propose": [
            "claim"
          ]
        },
        "contract": {
          "outcomes": {
            "comment_posted": {
              "schema": {
                "type": "object",
                "required": [
                  "issue",
                  "comment_id"
                ]
              }
            }
          }
        },
        "policy": {
          "retry": {
            "maxAttempts": 1
          }
        }
      }
    }
  },
  "start_node": {
    "name": "jira-intake-intake-done",
    "deadline": "2h"
  },
  "landing_node": {
    "name": "jira-intake-post-comment-done",
    "deadline": "2h"
  }
}
