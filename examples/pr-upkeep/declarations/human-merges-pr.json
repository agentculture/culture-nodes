{
  "name": "pr-upkeep-human-merges-pr",
  "trigger": {
    "kind": "timer",
    "with": {
      "legacy_reactions": [
        {
          "from": "readiness",
          "outcome": "passed",
          "when": null
        },
        {
          "from": "readiness",
          "outcome": "failed",
          "when": null
        }
      ]
    },
    "hop_limit": 10
  },
  "condition": "true",
  "action": {
    "kind": "human.ask",
    "with": {
      "graph_workflow": "workflow.yaml",
      "graph_node": "human-merges-pr",
      "graph_kind": "approval",
      "legacy": {
        "kind": "approval",
        "ownerRef": "team/platform-ai",
        "approverRef": "group/platform-maintainers",
        "decisionSchemaRef": "schema://pr-upkeep/merge-decision/v1",
        "deadline": "168h",
        "input": {
          "bindings": {
            "finding": "/run/input",
            "fix": "/nodes/fix/output",
            "readiness": "/nodes/readiness/output"
          }
        }
      }
    }
  },
  "start_node": {
    "name": "human-merges-pr-ready",
    "deadline": "none"
  },
  "landing_node": {
    "name": "human-merges-pr-done",
    "deadline": "168h"
  }
}
