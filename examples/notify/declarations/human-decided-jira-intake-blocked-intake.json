{
  "name": "notify-human-decided-jira-intake-blocked-intake",
  "trigger": {
    "kind": "human.decision",
    "reentry_limit": 0,
    "hop_limit": 8
  },
  "condition": "true",
  "action": {
    "kind": "discord.post",
    "with": {
      "uses": "actor://company/notify-discord@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "input": {
        "title": "{jira-intake-intake:id} intake decision: {outcome}",
        "description": "[{jira-intake-intake:id}](https://agentculture.atlassian.net/browse/{jira-intake-intake:id}) {jira-intake-intake:summary:}",
        "require_delivery": false
      },
      "graph_config": {
        "ownerRef": "team/platform-ai",
        "contract": {
          "outcomes": {
            "sent": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            },
            "delivery_failed": {
              "schema": {
                "type": "object",
                "required": [
                  "delivered",
                  "status_code"
                ]
              }
            }
          }
        }
      }
    }
  },
  "start_node": {
    "name": "jira-intake-blocked-intake-done",
    "deadline": "none"
  },
  "landing_node": {
    "name": "notify-human-decided-jira-intake-blocked-intake-done",
    "deadline": "5m"
  },
  "exposes": [
    "jira-intake-intake:id",
    "jira-intake-intake:summary",
    "outcome"
  ]
}
