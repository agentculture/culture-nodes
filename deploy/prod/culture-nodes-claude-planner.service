[Unit]
Description=Culture Nodes Claude planner bridge
After=network-online.target

[Service]
Environment=CLAUDE_CODE_BRIDGE_CONFIG=%h/.config/culture-nodes-bridges/planner.json
EnvironmentFile=-%h/.culture-nodes/bridge-push.env
ExecStart=%h/.local/bin/claude-code-bridge
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
